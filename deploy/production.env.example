# Copy to /home/app/novaseo/.env on the VPS and replace every placeholder.
# The CI deploy preserves this file on every release; never commit it.
API_PORT=3009
WEB_PORT=3010

DB_DATABASE=novaseo
DB_USERNAME=novaseo
DB_PASSWORD='replace-with-a-strong-database-password'

REDIS_PASSWORD='replace-with-a-strong-redis-password'

JWT_SECRET='replace-with-a-random-64-character-secret'
ENCRYPTION_KEY=''

# Generate a unique 32-byte key: openssl rand -hex 32
LLM_API_URL=''
LLM_API_KEY=''
LLM_MODEL=''

LOG_LEVEL=info
QUEUE_CONCURRENCY=5
