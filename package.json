{
    "name":  "novaseo-multi-platform-engine",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "dev":  "tsx watch src/server.ts",
                    "start":  "node dist/src/server.js",
                    "worker":  "node dist/src/worker.js",
                    "migrate":  "node dist/src/database/migrate.js",
                    "test":  "vitest run",
                    "lint":  "tsc -p tsconfig.json --noEmit"
                },
    "dependencies":  {
                         "bullmq":  "^5.16.0",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.21.0",
                         "helmet":  "^8.0.0",
                         "ioredis":  "^5.4.1",
                         "pg":  "^8.13.0",
                         "pino":  "^9.4.0",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "@types/express":  "^5.0.0",
                            "@types/node":  "^22.7.4",
                            "@types/pg":  "^8.11.10",
                            "eslint":  "^9.12.0",
                            "tsx":  "^4.19.1",
                            "typescript":  "^5.6.2",
                            "vitest":  "^2.1.2"
                        }
}
